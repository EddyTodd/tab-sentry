{
  "manifest_version": 3,
  "name": "Tab Sentry",
  "version": "1.4.0",
  "description": "Blocks unwanted popups and repairs deceptive video-player overlays.",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Sentry"
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shield-policy.js",
        "shield-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shield-policy.js",
        "content.js",
        "shield-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}

{
  "manifest_version": 3,
  "name": "Tab Sentry",
  "version": "1.2.0",
  "description": "Lightweight protection against unwanted page-created tabs and popup windows.",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Sentry"
  },
  "permissions": ["tabs", "storage", "webNavigation", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}
